import argparse
import os
import re
import textwrap
#from pprint import pprint,pformat

#######################################################################


def author_cleanup(author: str, email: str) -> str:
    """Return cleaned author, or "" to ignore"""
    if re.search(r'antmicro', email):
        return author + ", Antmicro Ltd."
    if re.search(r'github action', author):
        return ""
    if re.search(r'secturion', email):
        return author + ", Secturion Systems, Inc."
    if re.search(r'stud\.uni-heidelberg', email):
        return author + ", Heidelberg University"
    if re.search(r'tenstorrent', email):
        return author + ", Testorrent USA, Inc."
    if re.search(r'verilator-bot', author):
        return ""
    return author


def message_section(msg: str) -> int:
    """Return sorting-section number for given commit message"""
    if re.match(r'^Add', msg, flags=re.IGNORECASE):
        return 10
    if re.match(r'^Deprecate', msg, flags=re.IGNORECASE):
        return 20
    if re.match(r'^Remove', msg, flags=re.IGNORECASE):
        return 30
    if re.match(r'^Improve', msg, flags=re.IGNORECASE):
        return 40
    if re.match(r'^Change', msg, flags=re.IGNORECASE):
        return 50
    if re.match(r'^Support', msg, flags=re.IGNORECASE):
        return 60
    if re.match(r'^Optimize', msg, flags=re.IGNORECASE):
        return 70
    if re.match(r'^Fix', msg, flags=re.IGNORECASE):
        return 80
    if re.match(r'^(CI|Commentary|Internals|Merge|Tests)', msg, flags=re.IGNORECASE):
        return -1
    if re.match(r'^Bump.* from .* to .*', msg, flags=re.IGNORECASE):  # dependabot
        return -1
    return 0


def process() -> None:
    cmd = "git log"

    authors = {}
    msgs = {}
    issues = {}
    since_last_merge = True
    with os.popen(cmd) as fh:
        author = ""
        lineno = 0
        key = None
        for line in fh:
            lineno += 1
            line = line.rstrip()
            # print("l %s" % line)
            if re.match(r'^Date', line):
                key = None
                continue
            if re.match(r'^commit', line):
                key = None
                continue
            if re.search(r'Commentary: Changes update', line):  # Last merge
                since_last_merge = False
                continue
            if re.search(r'Version bump', line):  # Last release
                break

            am = re.match(r'^Author: (.*) <(.*)>', line)
            dm = re.match(r'^  +(.*)', line)

            if am:
                email = am.group(2)
                author = am.group(1)
                author = author_cleanup(author, email)

            elif author != "" and dm:
                msg = dm.group(1)

                bug_id = " %d" % lineno
                for m in re.finditer(r'\(#([0-9][0-9][0-9][0-9]+)', line):
                    bug_id = m.group(1)
                    issues[bug_id] = True

                section = message_section(msg)
                if section >= 0:
                    key = "%06s_%06s_%06d" % (section, bug_id, lineno)
                    if since_last_merge:
                        msgs[key] = '* ' + msg
                    authors[author] = True
                    # print("i [%s]  %s [%s]" % (key, msg, author))

                author = ""

            elif key:
                for m in re.finditer(r'(fix|fixes) *#\(?([0-9][0-9][0-9][0-9]+)',
                                     line,
                                     flags=re.IGNORECASE):
                    bug_id = m.group(2)
                    # print("K %s" % line)
                    issues[bug_id] = True
                    if since_last_merge:
                        if ("#" + bug_id) not in msgs[key]:
                            # print("K %s" % line)
                            msgs[key] += ' (#' + bug_id + ')'

    print()
    print("Insertion-sort the following lines into 'Changes' file:")
    print()
    dedup = {}
    for key in sorted(msgs.keys()):
        if msgs[key] not in dedup:
            dedup[msgs[key]] = True
            msg = msgs[key]
            if not re.search(r'\.$', msg):
                msg += '.'
            print(msg)

    print()
    print("**Issues resolved:**")
    print()
    text = ""
    for key in sorted(issues.keys()):
        text += " " if text else ""
        text += "(#" + key + ")"
    lines = textwrap.wrap(text, width=75)
    print("\n".join(lines))

    print()
    print("**Contributors:**")
    print()
    text = ""
    for key in sorted(authors.keys()):
        text += " " if text else ""
        text += "[" + key + "]"
    lines = textwrap.wrap(text, width=75)
    print("\n".join(lines))

    print()
    print("You may now want to clean up spelling, and commit:")
    print("  (make spelling | grep -vi 'writing output')")
    print("  git ci -am 'Commentary: Changes update'")
    print()


#######################################################################

parser = argparse.ArgumentParser(
    allow_abbrev=False,
    prog="log_changes",
