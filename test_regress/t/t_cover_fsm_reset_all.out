        // Group accepted simulator-style reset semantics, including reset include /
        // exclude behavior and nearby fallback cases that should still preserve FSMs.
        
        module fsm_reset_policy (
%000009     input logic clk,
%000001     input logic rst
        );
        
          typedef enum logic [0:0] {
            S0 = 1'b0,
            S1 = 1'b1
          } state_t;
        
%000001   state_t state_incl  /*verilator fsm_state*/;
%000001   state_t state_excl;
        
%000009   always_ff @(posedge clk) begin
%000007     if (rst) state_incl <= S0;
            else
%000007       case (state_incl)
        // [FSM coverage]
%000001        // [fsm_arc t.reset_policy_u.state_incl::S0->S1]
%000000        // [fsm_arc t.reset_policy_u.state_incl::S1->S0]
%000001        // [fsm_state t.reset_policy_u.state_incl::S0]
%000001        // [fsm_state t.reset_policy_u.state_incl::S1]
%000001         S0: state_incl <= S1;
%000006         default: state_incl <= S1;
              endcase
          end
        
%000009   always_ff @(posedge clk) begin
%000007     if (rst) state_excl <= S0;
            else
%000007       case (state_excl)
        // [FSM coverage]
%000001        // [fsm_arc t.reset_policy_u.state_excl::S0->S1]
%000000        // [fsm_arc t.reset_policy_u.state_excl::S1->S0]
%000001        // [fsm_state t.reset_policy_u.state_excl::S0]
%000001        // [fsm_state t.reset_policy_u.state_excl::S1]
%000001         S0: state_excl <= S1;
%000006         default: state_excl <= S1;
              endcase
          end
        endmodule
        
        module fsm_reset_other_assign_ok (
%000009     input logic clk,
%000001     input logic rst
        );
          typedef enum logic [1:0] {
            S0 = 2'b00,
            S1 = 2'b01,
            S2 = 2'b10
          } state_t;
        
%000000   logic aux;
%000001   logic start;
%000004   state_t state_q;
%000004   state_t state_d;
        
%000009   always_ff @(posedge clk) begin
%000007     if (rst) begin
%000002       aux <= 1'b1;
%000002       start <= 1'b1;
%000002       state_q <= S0;
%000002       aux <= 1'b0;
            end
%000007     else begin
%000007       state_q <= state_d;
            end
          end
        
 000010   always_comb begin
 000010     state_d = state_q;
 000010     case (state_q)
%000006       S0: state_d = start ? S1 : S2;
%000004       default: state_d = S0;
            endcase
          end
        endmodule
        
        module fsm_oneblock_reset_mismatch_ok (
%000009     input logic clk,
%000001     input logic rst
        );
          typedef enum logic [1:0] {
            S0 = 2'd0,
            S1 = 2'd1,
            S2 = 2'd2
          } state_t;
        
%000001   state_t state_q = S0;
%000001   state_t other_q = S2;
        
%000009   always_ff @(posedge clk) begin
%000007     if (rst) begin
%000002       other_q <= S0;
            end
%000007     else begin
%000007       case (state_q)
        // [FSM coverage]
%000001        // [fsm_arc t.oneblock_reset_mismatch_ok_u.state_q::S0->S1]
%000001        // [fsm_state t.oneblock_reset_mismatch_ok_u.state_q::S0]
%000001        // [fsm_state t.oneblock_reset_mismatch_ok_u.state_q::S1]
%000001        // [fsm_state t.oneblock_reset_mismatch_ok_u.state_q::S2]
%000001         S0: state_q <= S1;
%000006         default: state_q <= S2;
              endcase
            end
          end
        endmodule
        
        module fsm_oneblock_reset_nonconst_ok (
%000009     input logic clk,
%000001     input logic rst
        );
          typedef enum logic [1:0] {
            S0 = 2'd0,
            S1 = 2'd1,
            S2 = 2'd2
          } state_t;
        
%000001   state_t state_q = S0;
%000001   state_t other_q = S2;
        
          // Useful because the one-block reset fallback must ignore non-constant reset
          // assignments and still retain the supported case(state_q) FSM below.
%000009   always_ff @(posedge clk) begin
%000007     if (rst) begin
%000002       state_q <= other_q;
            end
%000007     else begin
%000007       case (state_q)
        // [FSM coverage]
%000000        // [fsm_arc t.oneblock_reset_nonconst_ok_u.state_q::S0->S1]
%000001        // [fsm_state t.oneblock_reset_nonconst_ok_u.state_q::S0]
%000000        // [fsm_state t.oneblock_reset_nonconst_ok_u.state_q::S1] *** UNCOVERED ***
%000001        // [fsm_state t.oneblock_reset_nonconst_ok_u.state_q::S2]
%000000         S0: state_q <= S1;
%000007         default: state_q <= S2;
              endcase
            end
          end
        endmodule
        
        module fsm_reset_active_low (
%000009     input logic clk,
%000002     input logic rst_n
        );
          typedef enum logic [1:0] {
            S0 = 2'd0,
            S1 = 2'd1,
            S2 = 2'd2
          } state_t;
        
%000003   state_t sync_q;
%000003   state_t sync_d;
%000003   state_t async_q;
%000003   state_t async_d;
%000003   state_t oneblock_q;
%000003   state_t tern_q;
%000003   state_t tern_d;
%000003   state_t chain_q;
%000003   logic [1:0] count;
%000003   logic busy;
        
          // V3Const writes 'if (!rst_n) R; else C' as 'if (rst_n) C; else R', and without other
          // coverage folds this one into 'sync_q <= rst_n ? sync_d : S0'
%000009   always_ff @(posedge clk) begin
%000006     if (!rst_n) sync_q <= S0;
%000006     else sync_q <= sync_d;
          end
        
          // Branch coverage lifts the '?:' into an if/else on a temporary
%000009   always_ff @(posedge clk) begin
%000009     tern_q <= !rst_n ? S0 : tern_d;
          end
        
 000010   always_comb begin
 000010     tern_d = tern_q;
~000010     case (tern_q)
        // [FSM coverage]
%000003        // [fsm_arc t.reset_active_low_u.tern_q::S0->S1]
%000001        // [fsm_arc t.reset_active_low_u.tern_q::S1->S0]
%000002        // [fsm_arc t.reset_active_low_u.tern_q::S1->S2]
%000001        // [fsm_arc t.reset_active_low_u.tern_q::S2->S0]
%000003        // [fsm_state t.reset_active_low_u.tern_q::S0]
%000003        // [fsm_state t.reset_active_low_u.tern_q::S1]
%000002        // [fsm_state t.reset_active_low_u.tern_q::S2]
%000005       S0: tern_d = S1;
%000003       S1: tern_d = S2;
%000002       default: tern_d = S0;
            endcase
          end
        
 000010   always_ff @(posedge clk or negedge rst_n) begin
%000006     if (!rst_n) begin
%000004       async_q <= S0;
%000004       count <= '0;
            end
%000006     else begin
%000006       async_q <= async_d;
%000006       count <= count + 1'b1;
            end
          end
        
 000010   always_comb begin
 000010     sync_d = sync_q;
~000010     case (sync_q)
        // [FSM coverage]
%000003        // [fsm_arc t.reset_active_low_u.sync_q::S0->S1]
%000001        // [fsm_arc t.reset_active_low_u.sync_q::S1->S0]
%000002        // [fsm_arc t.reset_active_low_u.sync_q::S1->S2]
%000001        // [fsm_arc t.reset_active_low_u.sync_q::S2->S0]
%000003        // [fsm_state t.reset_active_low_u.sync_q::S0]
%000003        // [fsm_state t.reset_active_low_u.sync_q::S1]
%000002        // [fsm_state t.reset_active_low_u.sync_q::S2]
%000005       S0: sync_d = S1;
%000003       S1: sync_d = S2;
%000002       default: sync_d = S0;
            endcase
          end
        
 000011   always_comb begin
 000011     async_d = async_q;
~000011     case (async_q)
        // [FSM coverage]
%000003        // [fsm_arc t.reset_active_low_u.async_q::S0->S1]
%000001        // [fsm_arc t.reset_active_low_u.async_q::S1->S0]
%000002        // [fsm_arc t.reset_active_low_u.async_q::S1->S2]
%000001        // [fsm_arc t.reset_active_low_u.async_q::S2->S0]
%000003        // [fsm_state t.reset_active_low_u.async_q::S0]
%000003        // [fsm_state t.reset_active_low_u.async_q::S1]
%000002        // [fsm_state t.reset_active_low_u.async_q::S2]
%000006       S0: async_d = S1;
%000003       S1: async_d = S2;
%000002       default: async_d = S0;
            endcase
          end
        
%000009   always_ff @(posedge clk) begin
%000006     if (!rst_n) oneblock_q <= S0;
            else
%000006       case (oneblock_q)
        // [FSM coverage]
%000003        // [fsm_arc t.reset_active_low_u.oneblock_q::S0->S1]
%000001        // [fsm_arc t.reset_active_low_u.oneblock_q::S1->S0]
%000002        // [fsm_arc t.reset_active_low_u.oneblock_q::S1->S2]
%000001        // [fsm_arc t.reset_active_low_u.oneblock_q::S2->S0]
%000003        // [fsm_state t.reset_active_low_u.oneblock_q::S0]
%000003        // [fsm_state t.reset_active_low_u.oneblock_q::S1]
%000002        // [fsm_state t.reset_active_low_u.oneblock_q::S2]
%000003         S0: oneblock_q <= S1;
%000002         S1: oneblock_q <= S2;
%000001         default: oneblock_q <= S0;
              endcase
          end
        
          // Two statements per branch keep the chain from folding into one assignment
%000009   always_ff @(posedge clk) begin
%000006     if (!rst_n) begin
%000003       chain_q <= S0;
%000003       busy <= 1'b0;
            end
%000003     else if (chain_q == S0) begin
        // [FSM coverage]
%000003        // [fsm_arc t.reset_active_low_u.chain_q::S0->S1]
%000001        // [fsm_arc t.reset_active_low_u.chain_q::S1->S0]
%000002        // [fsm_arc t.reset_active_low_u.chain_q::S1->S2]
%000001        // [fsm_arc t.reset_active_low_u.chain_q::S2->S0]
%000003        // [fsm_state t.reset_active_low_u.chain_q::S0]
%000003        // [fsm_state t.reset_active_low_u.chain_q::S1]
%000002        // [fsm_state t.reset_active_low_u.chain_q::S2]
%000003       chain_q <= S1;
%000003       busy <= 1'b1;
            end
%000002     else if (chain_q == S1) begin
%000002       chain_q <= S2;
%000002       busy <= 1'b1;
            end
%000001     else begin
%000001       chain_q <= S0;
%000001       busy <= 1'b0;
            end
          end
        endmodule
        
        module fsm_enable (
%000009     input logic clk,
%000002     input logic rst,
%000002     input logic en,
%000004     input logic sel
        );
          typedef enum logic [1:0] {
            S0 = 2'd0,
            S1 = 2'd1,
            S2 = 2'd2
          } state_t;
%000002   logic rst_n;
%000007   assign rst_n = !rst;
%000001   logic stall;
%000009   assign stall = !en;
%000001   state_t b_d;
          assign b_d = S2;
        
          // Registers with an enable, which otherwise holds the state
        
%000003   state_t elsif_q;
%000003   state_t elsif_d;
 000010   always_comb begin
 000010     elsif_d = elsif_q;
~000010     case (elsif_q)
        // [FSM coverage]
%000003        // [fsm_arc t.enable_u.elsif_q::S0->S1]
%000001        // [fsm_arc t.enable_u.elsif_q::S1->S0]
%000001        // [fsm_arc t.enable_u.elsif_q::S1->S2]
%000001        // [fsm_arc t.enable_u.elsif_q::S2->S0]
%000003        // [fsm_state t.enable_u.elsif_q::S0]
%000003        // [fsm_state t.enable_u.elsif_q::S1]
%000001        // [fsm_state t.enable_u.elsif_q::S2]
%000005       S0: elsif_d = S1;
%000004       S1: elsif_d = S2;
%000001       S2: elsif_d = S0;
%000000       default: elsif_d = S0;
            endcase
          end
%000009   always_ff @(posedge clk) begin
%000003     if (rst) elsif_q <= S0;
%000005     else if (en) elsif_q <= elsif_d;
          end
        
%000003   state_t cond_q;
%000003   state_t cond_d;
 000010   always_comb begin
 000010     cond_d = cond_q;
~000010     case (cond_q)
        // [FSM coverage]
%000003        // [fsm_arc t.enable_u.cond_q::S0->S1]
%000001        // [fsm_arc t.enable_u.cond_q::S1->S0]
%000001        // [fsm_arc t.enable_u.cond_q::S1->S2]
%000001        // [fsm_arc t.enable_u.cond_q::S2->S0]
%000003        // [fsm_state t.enable_u.cond_q::S0]
%000003        // [fsm_state t.enable_u.cond_q::S1]
%000001        // [fsm_state t.enable_u.cond_q::S2]
%000005       S0: cond_d = S1;
%000004       S1: cond_d = S2;
%000001       S2: cond_d = S0;
%000000       default: cond_d = S0;
            endcase
          end
%000009   always_ff @(posedge clk) cond_q <= rst ? S0 : (en ? cond_d : cond_q);
        
%000003   state_t lowrst_q;
%000003   state_t lowrst_d;
 000010   always_comb begin
 000010     lowrst_d = lowrst_q;
~000010     case (lowrst_q)
        // [FSM coverage]
%000003        // [fsm_arc t.enable_u.lowrst_q::S0->S1]
%000001        // [fsm_arc t.enable_u.lowrst_q::S1->S0]
%000001        // [fsm_arc t.enable_u.lowrst_q::S1->S2]
%000001        // [fsm_arc t.enable_u.lowrst_q::S2->S0]
%000003        // [fsm_state t.enable_u.lowrst_q::S0]
%000003        // [fsm_state t.enable_u.lowrst_q::S1]
%000001        // [fsm_state t.enable_u.lowrst_q::S2]
%000005       S0: lowrst_d = S1;
%000004       S1: lowrst_d = S2;
%000001       S2: lowrst_d = S0;
%000000       default: lowrst_d = S0;
            endcase
          end
%000009   always_ff @(posedge clk) begin
%000006     if (!rst_n) lowrst_q <= S0;
%000005     else if (en) lowrst_q <= lowrst_d;
          end
        
%000003   state_t lowcond_q;
%000003   state_t lowcond_d;
 000010   always_comb begin
 000010     lowcond_d = lowcond_q;
~000010     case (lowcond_q)
        // [FSM coverage]
%000003        // [fsm_arc t.enable_u.lowcond_q::S0->S1]
%000001        // [fsm_arc t.enable_u.lowcond_q::S1->S0]
%000001        // [fsm_arc t.enable_u.lowcond_q::S1->S2]
%000001        // [fsm_arc t.enable_u.lowcond_q::S2->S0]
%000003        // [fsm_state t.enable_u.lowcond_q::S0]
%000003        // [fsm_state t.enable_u.lowcond_q::S1]
%000001        // [fsm_state t.enable_u.lowcond_q::S2]
%000005       S0: lowcond_d = S1;
%000004       S1: lowcond_d = S2;
%000001       S2: lowcond_d = S0;
%000000       default: lowcond_d = S0;
            endcase
          end
%000009   always_ff @(posedge clk) lowcond_q <= rst_n ? (en ? lowcond_d : lowcond_q) : S0;
        
%000003   state_t noreset_q;
%000003   state_t noreset_d;
 000010   always_comb begin
 000010     noreset_d = noreset_q;
~000010     case (noreset_q)
        // [FSM coverage]
%000003        // [fsm_arc t.enable_u.noreset_q::S0->S1]
%000003        // [fsm_arc t.enable_u.noreset_q::S1->S2]
%000002        // [fsm_arc t.enable_u.noreset_q::S2->S0]
%000003        // [fsm_state t.enable_u.noreset_q::S0]
%000003        // [fsm_state t.enable_u.noreset_q::S1]
%000003        // [fsm_state t.enable_u.noreset_q::S2]
%000004       S0: noreset_d = S1;
%000003       S1: noreset_d = S2;
%000003       S2: noreset_d = S0;
%000000       default: noreset_d = S0;
            endcase
          end
%000009   always_ff @(posedge clk) begin
%000008     if (en) noreset_q <= noreset_d;
          end
        
%000003   state_t noreset_cond_q;
%000003   state_t noreset_cond_d;
 000010   always_comb begin
 000010     noreset_cond_d = noreset_cond_q;
~000010     case (noreset_cond_q)
        // [FSM coverage]
%000003        // [fsm_arc t.enable_u.noreset_cond_q::S0->S1]
%000003        // [fsm_arc t.enable_u.noreset_cond_q::S1->S2]
%000002        // [fsm_arc t.enable_u.noreset_cond_q::S2->S0]
%000003        // [fsm_state t.enable_u.noreset_cond_q::S0]
%000003        // [fsm_state t.enable_u.noreset_cond_q::S1]
%000003        // [fsm_state t.enable_u.noreset_cond_q::S2]
%000004       S0: noreset_cond_d = S1;
%000003       S1: noreset_cond_d = S2;
%000003       S2: noreset_cond_d = S0;
%000000       default: noreset_cond_d = S0;
            endcase
          end
%000009   always_ff @(posedge clk) noreset_cond_q <= en ? noreset_cond_d : noreset_cond_q;
        
%000003   state_t hold_q;
%000003   state_t hold_d;
 000010   always_comb begin
 000010     hold_d = hold_q;
~000010     case (hold_q)
        // [FSM coverage]
%000003        // [fsm_arc t.enable_u.hold_q::S0->S1]
%000001        // [fsm_arc t.enable_u.hold_q::S1->S0]
%000001        // [fsm_arc t.enable_u.hold_q::S1->S2]
%000001        // [fsm_arc t.enable_u.hold_q::S2->S0]
%000003        // [fsm_state t.enable_u.hold_q::S0]
%000003        // [fsm_state t.enable_u.hold_q::S1]
%000001        // [fsm_state t.enable_u.hold_q::S2]
%000005       S0: hold_d = S1;
%000004       S1: hold_d = S2;
%000001       S2: hold_d = S0;
%000000       default: hold_d = S0;
            endcase
          end
%000009   always_ff @(posedge clk) begin
%000003     if (rst) hold_q <= S0;
%000005     else if (en) hold_q <= hold_d;
%000001     else hold_q <= hold_q;
          end
        
%000003   state_t noreset_hold_q;
%000003   state_t noreset_hold_d;
 000010   always_comb begin
 000010     noreset_hold_d = noreset_hold_q;
~000010     case (noreset_hold_q)
        // [FSM coverage]
%000003        // [fsm_arc t.enable_u.noreset_hold_q::S0->S1]
%000003        // [fsm_arc t.enable_u.noreset_hold_q::S1->S2]
%000002        // [fsm_arc t.enable_u.noreset_hold_q::S2->S0]
%000003        // [fsm_state t.enable_u.noreset_hold_q::S0]
%000003        // [fsm_state t.enable_u.noreset_hold_q::S1]
%000003        // [fsm_state t.enable_u.noreset_hold_q::S2]
%000004       S0: noreset_hold_d = S1;
%000003       S1: noreset_hold_d = S2;
%000003       S2: noreset_hold_d = S0;
%000000       default: noreset_hold_d = S0;
            endcase
          end
%000009   always_ff @(posedge clk) begin
%000008     if (en) noreset_hold_q <= noreset_hold_d;
%000001     else noreset_hold_q <= noreset_hold_q;
          end
        
%000003   state_t stall_q;
%000003   state_t stall_d;
 000010   always_comb begin
 000010     stall_d = stall_q;
~000010     case (stall_q)
        // [FSM coverage]
%000003        // [fsm_arc t.enable_u.stall_q::S0->S1]
%000001        // [fsm_arc t.enable_u.stall_q::S1->S0]
%000001        // [fsm_arc t.enable_u.stall_q::S1->S2]
%000001        // [fsm_arc t.enable_u.stall_q::S2->S0]
%000003        // [fsm_state t.enable_u.stall_q::S0]
%000003        // [fsm_state t.enable_u.stall_q::S1]
%000001        // [fsm_state t.enable_u.stall_q::S2]
%000005       S0: stall_d = S1;
%000004       S1: stall_d = S2;
%000001       S2: stall_d = S0;
%000000       default: stall_d = S0;
            endcase
          end
%000009   always_ff @(posedge clk) stall_q <= rst ? S0 : (stall ? stall_q : stall_d);
        
%000003   state_t stall_if_q;
%000003   state_t stall_if_d;
 000010   always_comb begin
 000010     stall_if_d = stall_if_q;
~000010     case (stall_if_q)
        // [FSM coverage]
%000003        // [fsm_arc t.enable_u.stall_if_q::S0->S1]
%000001        // [fsm_arc t.enable_u.stall_if_q::S1->S0]
%000001        // [fsm_arc t.enable_u.stall_if_q::S1->S2]
%000001        // [fsm_arc t.enable_u.stall_if_q::S2->S0]
%000003        // [fsm_state t.enable_u.stall_if_q::S0]
%000003        // [fsm_state t.enable_u.stall_if_q::S1]
%000001        // [fsm_state t.enable_u.stall_if_q::S2]
%000005       S0: stall_if_d = S1;
%000004       S1: stall_if_d = S2;
%000001       S2: stall_if_d = S0;
%000000       default: stall_if_d = S0;
            endcase
          end
%000009   always_ff @(posedge clk) begin
%000003     if (rst) stall_if_q <= S0;
%000005     else if (stall) stall_if_q <= stall_if_q;
