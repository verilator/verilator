//      // verilator_coverage annotation
        // DESCRIPTION: Verilator: FSM coverage of the common FSM coding styles
        //
        // This file ONLY is placed under the Creative Commons Public Domain.
        // SPDX-FileCopyrightText: 2026 Wilson Snyder
        // SPDX-License-Identifier: CC0-1.0
        
        package fsm_styles_pkg;
          typedef enum logic [1:0] {
            S0,
            S1,
            S2,
            S3
          } st_t;
        endpackage
        
        // Two processes
        module fsm_two_proc (
            input logic clk,
            input logic rst,
            input logic go
        );
          import fsm_styles_pkg::*;
          st_t state, next;
          always_comb begin
            next = state;
~000010     case (state)
        // [FSM coverage]
 000010        // [fsm_arc t.two_proc_u.state::S0->S1]
%000000        // [fsm_arc t.two_proc_u.state::S1->S0]
 000010        // [fsm_arc t.two_proc_u.state::S1->S2]
%000009        // [fsm_arc t.two_proc_u.state::S2->S0]
 000010        // [fsm_state t.two_proc_u.state::S0]
 000010        // [fsm_state t.two_proc_u.state::S1]
 000010        // [fsm_state t.two_proc_u.state::S2]
              S0: if (go) next = S1;
              S1: next = S2;
              S2: next = S0;
              default: next = S0;
            endcase
          end
          always_ff @(posedge clk) if (rst) state <= S0; else state <= next;
        endmodule
        
        // Items that assign another variable first
        module fsm_other_assign (
            input logic clk,
            input logic rst,
            input logic go
        );
          import fsm_styles_pkg::*;
          st_t state, next;
          logic busy;
          always_comb begin
            next = state;
            busy = 0;
~000010     case (state)
        // [FSM coverage]
 000010        // [fsm_arc t.other_assign_u.state::S0->S1]
%000000        // [fsm_arc t.other_assign_u.state::S1->S0]
 000010        // [fsm_arc t.other_assign_u.state::S1->S2]
%000009        // [fsm_arc t.other_assign_u.state::S2->S0]
 000010        // [fsm_state t.other_assign_u.state::S0]
 000010        // [fsm_state t.other_assign_u.state::S1]
 000010        // [fsm_state t.other_assign_u.state::S2]
              S0: begin
                busy = 1;
                if (go) next = S1;
              end
              S1: begin
                busy = 1;
                next = S2;
              end
              default: next = S0;
            endcase
          end
          always_ff @(posedge clk) if (rst) state <= S0; else state <= next;
        endmodule
        
        // A register with an enable
        module fsm_enable (
            input logic clk,
            input logic rst,
            input logic en,
            input logic go
        );
          import fsm_styles_pkg::*;
          st_t state, next;
          always_comb begin
            next = state;
~000010     case (state)
        // [FSM coverage]
 000010        // [fsm_arc t.enable_u.state::S0->S1]
%000000        // [fsm_arc t.enable_u.state::S1->S0]
%000009        // [fsm_arc t.enable_u.state::S1->S2]
%000009        // [fsm_arc t.enable_u.state::S2->S0]
 000010        // [fsm_state t.enable_u.state::S0]
 000010        // [fsm_state t.enable_u.state::S1]
%000009        // [fsm_state t.enable_u.state::S2]
              S0: if (go) next = S1;
              S1: next = S2;
              default: next = S0;
            endcase
          end
          always_ff @(posedge clk) if (rst) state <= S0; else if (en) state <= next;
        endmodule
        
        // One process with a compound reset
        module fsm_compound_reset (
            input logic clk,
            input logic rst,
            input logic flush,
            input logic go
        );
          import fsm_styles_pkg::*;
          st_t state;
          always_ff @(posedge clk)
            if (rst | flush) state <= S0;
            else
~000010       case (state)
        // [FSM coverage]
 000010        // [fsm_arc t.compound_reset_u.state::S0->S1]
%000000        // [fsm_arc t.compound_reset_u.state::S1->S0]
 000010        // [fsm_arc t.compound_reset_u.state::S1->S2]
%000009        // [fsm_arc t.compound_reset_u.state::S2->S0]
 000010        // [fsm_state t.compound_reset_u.state::S0]
 000010        // [fsm_state t.compound_reset_u.state::S1]
 000010        // [fsm_state t.compound_reset_u.state::S2]
                S0: if (go) state <= S1;
                S1: state <= S2;
                default: state <= S0;
              endcase
        endmodule
        
        // An if chain whose first branch is on an input
        module fsm_input_guard (
            input logic clk,
            input logic rst,
            input logic start,
            input logic done
        );
          import fsm_styles_pkg::*;
          st_t state;
          always_ff @(posedge clk)
            if (rst) state <= S0;
            else if (start) state <= S1;
%000002     else if (state == S1 && done) state <= S2;
        // [FSM coverage]
%000001        // [fsm_arc t.input_guard_u.state::S0->S1]
%000000        // [fsm_arc t.input_guard_u.state::S1->S0]
%000001        // [fsm_arc t.input_guard_u.state::S1->S2]
%000001        // [fsm_arc t.input_guard_u.state::S2->S0]
%000000        // [fsm_arc t.input_guard_u.state::S2->S1]
%000002        // [fsm_state t.input_guard_u.state::S0]
%000001        // [fsm_state t.input_guard_u.state::S1]
%000001        // [fsm_state t.input_guard_u.state::S2]
            else if (state == S2) state <= S0;
        endmodule
        
        // A branch on an OR of states
        module fsm_or_states (
            input logic clk,
            input logic rst,
            input logic go
        );
          import fsm_styles_pkg::*;
          st_t state;
          always_ff @(posedge clk)
            if (rst) state <= S0;
~000010     else if (state == S0) begin
        // [FSM coverage]
 000010        // [fsm_arc t.or_states_u.state::S0->S1]
%000000        // [fsm_arc t.or_states_u.state::S1->S0]
 000010        // [fsm_arc t.or_states_u.state::S1->S3]
%000000        // [fsm_arc t.or_states_u.state::S2->S0]
%000000        // [fsm_arc t.or_states_u.state::S2->S3]
%000009        // [fsm_arc t.or_states_u.state::S3->S0]
 000010        // [fsm_state t.or_states_u.state::S0]
 000010        // [fsm_state t.or_states_u.state::S1]
%000000        // [fsm_state t.or_states_u.state::S2] *** UNCOVERED ***
 000010        // [fsm_state t.or_states_u.state::S3]
              if (go) state <= S1;
            end else if (state == S1 | state == S2) state <= S3;
            else state <= S0;
        endmodule
        
        // An else-if chain inside an item, with three targets
        module fsm_three_targets (
            input logic clk,
            input logic rst,
            input logic a,
            input logic b
        );
          import fsm_styles_pkg::*;
          st_t state, next;
          always_comb begin
            next = state;
~000020     case (state)
        // [FSM coverage]
 000010        // [fsm_arc t.three_targets_u.state::S0->S1]
%000005        // [fsm_arc t.three_targets_u.state::S0->S2]
%000005        // [fsm_arc t.three_targets_u.state::S0->S3]
 000010        // [fsm_arc t.three_targets_u.state::S1->S0]
%000005        // [fsm_arc t.three_targets_u.state::S2->S0]
%000004        // [fsm_arc t.three_targets_u.state::S3->S0]
 000020        // [fsm_state t.three_targets_u.state::S0]
 000010        // [fsm_state t.three_targets_u.state::S1]
%000005        // [fsm_state t.three_targets_u.state::S2]
%000005        // [fsm_state t.three_targets_u.state::S3]
              S0: if (a) next = S1;
              else if (b) next = S2;
              else next = S3;
              default: next = S0;
            endcase
          end
          always_ff @(posedge clk) if (rst) state <= S0; else state <= next;
        endmodule
        
        // A register written beside others under an enable, with an active-low reset
        module fsm_beside_others (
            input logic clk,
            input logic rst_n,
            input logic en,
            input logic go
        );
          import fsm_styles_pkg::*;
          st_t state, next;
          logic [7:0] pc, hold;
          always_comb begin
            next = state;
~000010     case (state)
        // [FSM coverage]
 000010        // [fsm_arc t.beside_others_u.state::S0->S1]
%000000        // [fsm_arc t.beside_others_u.state::S1->S0]
%000009        // [fsm_arc t.beside_others_u.state::S1->S2]
%000009        // [fsm_arc t.beside_others_u.state::S2->S0]
 000010        // [fsm_state t.beside_others_u.state::S0]
 000010        // [fsm_state t.beside_others_u.state::S1]
%000009        // [fsm_state t.beside_others_u.state::S2]
              S0: if (go) next = S1;
              S1: next = S2;
              default: next = S0;
            endcase
          end
          always_ff @(posedge clk or negedge rst_n)
            if (~rst_n) begin
              state <= S0;
              pc <= '0;
            end else if (en) begin
              pc <= pc + 8'd1;
              state <= next;
            end else hold <= pc;
        endmodule
        
        // Holds through ?:
        module fsm_ternary_hold (
            input logic clk,
            input logic rst,
            input logic go,
            input logic done
        );
          import fsm_styles_pkg::*;
          st_t state_n, state_r;
          always_comb
%000006     case (state_r)
        // [FSM coverage]
%000006        // [fsm_arc t.ternary_hold_u.state_r::S0->S1]
%000000        // [fsm_arc t.ternary_hold_u.state_r::S1->S0]
%000005        // [fsm_arc t.ternary_hold_u.state_r::S1->S2]
%000005        // [fsm_arc t.ternary_hold_u.state_r::S2->S0]
%000006        // [fsm_state t.ternary_hold_u.state_r::S0]
%000006        // [fsm_state t.ternary_hold_u.state_r::S1]
%000005        // [fsm_state t.ternary_hold_u.state_r::S2]
              S0: state_n = go ? S1 : state_r;
              S1: state_n = done ? S2 : state_r;
              default: state_n = S0;
            endcase
          always_ff @(posedge clk) if (rst) state_r <= S0; else state_r <= state_n;
        endmodule
        
        // A default next state, then an override
        module fsm_default_override (
            input logic clk,
            input logic rst,
            input logic abort
        );
          import fsm_styles_pkg::*;
          st_t state, next;
          always_comb begin
            next = state;
~000014     case (state)
        // [FSM coverage]
 000013        // [fsm_arc t.default_override_u.state::S0->S1]
%000000        // [fsm_arc t.default_override_u.state::S1->S0]
 000013        // [fsm_arc t.default_override_u.state::S1->S2]
 000013        // [fsm_arc t.default_override_u.state::S2->S0]
 000014        // [fsm_state t.default_override_u.state::S0]
 000013        // [fsm_state t.default_override_u.state::S1]
 000013        // [fsm_state t.default_override_u.state::S2]
              S0: next = S1;
              S1: begin
                next = S2;
                if (abort) next = S0;
              end
              default: next = S0;
            endcase
          end
          always_ff @(posedge clk) if (rst) state <= S0; else state <= next;
        endmodule
        
        // A reset branch that assigns another variable first, and the state twice
        module fsm_reset_other_first (
            input logic clk,
            input logic rst,
            input logic go
        );
          import fsm_styles_pkg::*;
          st_t state;
          logic busy;
          always_ff @(posedge clk)
            if (rst) begin
              busy <= 0;
              state <= S1;
              state <= S0;
            end else
~000010       case (state)
        // [FSM coverage]
 000010        // [fsm_arc t.reset_other_first_u.state::S0->S1]
%000000        // [fsm_arc t.reset_other_first_u.state::S1->S0]
 000010        // [fsm_arc t.reset_other_first_u.state::S1->S2]
%000009        // [fsm_arc t.reset_other_first_u.state::S2->S0]
 000010        // [fsm_state t.reset_other_first_u.state::S0]
 000010        // [fsm_state t.reset_other_first_u.state::S1]
 000010        // [fsm_state t.reset_other_first_u.state::S2]
                S0: if (go) state <= S1;
                S1: state <= S2;
                default: state <= S0;
              endcase
        endmodule
        
        // A case on a combinational address decode is not an FSM
        module fsm_case_on_wire (
            input logic clk,
            input logic [15:0] paddr,
            input logic [7:0] wdata,
            input logic wr
        );
          localparam logic [15:0] REG_A = 16'h0000;
          localparam logic [15:0] REG_B = 16'h4000;
          logic [15:0] entry;
          logic [7:0] a, b, rdata;
          assign entry = {paddr[15:3], 3'b000};
          always_ff @(posedge clk) begin
            case (entry)
              REG_A: rdata <= a;
              REG_B: rdata <= b;
              default: rdata <= '0;
            endcase
            if (wr) begin
              if (entry == REG_A) a <= wdata;
              if (entry == REG_B) b <= wdata;
            end
          end
        endmodule
        
        // Unsized localparam states
        module fsm_unsized_params (
            input logic clk,
            input logic trst,
            input logic tms
        );
          localparam IDLE = 0;
          localparam SELECT = 1;
          localparam CAPTURE = 2;
          logic [1:0] state, nstate;
          always_comb begin
            nstate = state;
~000011     case (state)
        // [FSM coverage]
%000000        // [fsm_arc t.unsized_params_u.state::CAPTURE->IDLE]
 000010        // [fsm_arc t.unsized_params_u.state::IDLE->SELECT]
%000000        // [fsm_arc t.unsized_params_u.state::SELECT->CAPTURE]
 000010        // [fsm_arc t.unsized_params_u.state::SELECT->IDLE]
%000000        // [fsm_state t.unsized_params_u.state::CAPTURE] *** UNCOVERED ***
 000011        // [fsm_state t.unsized_params_u.state::IDLE]
 000010        // [fsm_state t.unsized_params_u.state::SELECT]
              IDLE: nstate = tms ? SELECT : IDLE;
              SELECT: nstate = tms ? IDLE : CAPTURE;
              CAPTURE: nstate = IDLE;
              default: nstate = IDLE;
            endcase
          end
          always_ff @(posedge clk or negedge trst) if (!trst) state <= IDLE; else state <= nstate;
        endmodule
        
        // A pre-decoded state alias in a condition
        module fsm_alias_cond (
            input logic clk,
            input logic rst,
            input logic go
        );
          import fsm_styles_pkg::*;
          st_t state;
          logic is_idle;
          assign is_idle = state == S0;
          always_ff @(posedge clk)
            if (rst) state <= S0;
 000020     else if (is_idle) begin
        // [FSM coverage]
 000019        // [fsm_arc t.alias_cond_u.state::S0->S1]
 000019        // [fsm_arc t.alias_cond_u.state::S1->S0]
 000020        // [fsm_state t.alias_cond_u.state::S0]
 000019        // [fsm_state t.alias_cond_u.state::S1]
              if (go) state <= S1;
            end else if (state == S1) state <= S0;
        endmodule
        
        // Two FSMs in one clocked block
        module fsm_two_in_block (
            input logic clk,
            input logic rst,
            input logic go
        );
          import fsm_styles_pkg::*;
          st_t a, b;
          always_ff @(posedge clk)
            if (rst) begin
              a <= S0;
              b <= S0;
            end else begin
 000020       case (a)
        // [FSM coverage]
 000019        // [fsm_arc t.two_in_block_u.a::S0->S1]
 000019        // [fsm_arc t.two_in_block_u.a::S1->S0]
 000020        // [fsm_state t.two_in_block_u.a::S0]
 000019        // [fsm_state t.two_in_block_u.a::S1]
                S0: if (go) a <= S1;
                default: a <= S0;
              endcase
 000020       case (b)
        // [FSM coverage]
 000020        // [fsm_arc t.two_in_block_u.b::S0->S2]
 000019        // [fsm_arc t.two_in_block_u.b::S2->S0]
 000020        // [fsm_state t.two_in_block_u.b::S0]
 000020        // [fsm_state t.two_in_block_u.b::S2]
                S0: b <= S2;
                default: b <= S0;
              endcase
            end
        endmodule
        
        // Two FSMs in one combinational block
        module fsm_two_in_comb (
            input logic clk,
            input logic rst,
            input logic go
        );
          import fsm_styles_pkg::*;
          st_t a_q, a_d, b_q, b_d;
          always_comb begin
            a_d = a_q;
            b_d = b_q;
 000020     case (a_q)
        // [FSM coverage]
 000019        // [fsm_arc t.two_in_comb_u.a_q::S0->S1]
 000019        // [fsm_arc t.two_in_comb_u.a_q::S1->S0]
 000020        // [fsm_state t.two_in_comb_u.a_q::S0]
 000019        // [fsm_state t.two_in_comb_u.a_q::S1]
              S0: if (go) a_d = S1;
              default: a_d = S0;
            endcase
 000020     case (b_q)
        // [FSM coverage]
 000020        // [fsm_arc t.two_in_comb_u.b_q::S0->S2]
 000019        // [fsm_arc t.two_in_comb_u.b_q::S2->S0]
 000020        // [fsm_state t.two_in_comb_u.b_q::S0]
 000020        // [fsm_state t.two_in_comb_u.b_q::S2]
              S0: b_d = S2;
              default: b_d = S0;
            endcase
          end
          always_ff @(posedge clk)
            if (rst) begin
              a_q <= S0;
              b_q <= S0;
            end else begin
              a_q <= a_d;
              b_q <= b_d;
            end
        endmodule
        
        // Two case statements on one register in one block: the later write wins
        module fsm_same_reg_twice (
            input logic clk,
            input logic rst,
            input logic go
        );
          import fsm_styles_pkg::*;
          st_t state;
          always_ff @(posedge clk)
            if (rst) state <= S0;
            else begin
~000010       case (state)
        // [FSM coverage]
 000010        // [fsm_arc t.same_reg_twice_u.state::S0->S1]
%000000        // [fsm_arc t.same_reg_twice_u.state::S1->S0]
 000010        // [fsm_arc t.same_reg_twice_u.state::S1->S2]
%000009        // [fsm_arc t.same_reg_twice_u.state::S2->S0]
 000010        // [fsm_state t.same_reg_twice_u.state::S0]
 000010        // [fsm_state t.same_reg_twice_u.state::S1]
 000010        // [fsm_state t.same_reg_twice_u.state::S2]
                S0: if (go) state <= S1;
                S1: state <= S0;
                default: state <= S0;
              endcase
              case (state)
                S1: state <= S2;
                default: ;
              endcase
            end
        endmodule
        
        // Two if chains on one register in one block: the later write wins
        module fsm_ifchain_twice (
            input logic clk,
            input logic rst,
            input logic go
        );
          import fsm_styles_pkg::*;
          st_t state;
          always_ff @(posedge clk)
            if (rst) state <= S0;
            else begin
              if (state == S0 && go) state <= S1;
              else if (state == S1) state <= S0;
~000019       if (state == S1) state <= S2;
        // [FSM coverage]
%000001        // [fsm_arc t.ifchain_twice_u.state::S0->S1]
%000000        // [fsm_arc t.ifchain_twice_u.state::S1->S0]
 000019        // [fsm_arc t.ifchain_twice_u.state::S1->S2]
%000000        // [fsm_arc t.ifchain_twice_u.state::S2->S0]
 000018        // [fsm_arc t.ifchain_twice_u.state::S2->S1]
%000001        // [fsm_state t.ifchain_twice_u.state::S0]
 000019        // [fsm_state t.ifchain_twice_u.state::S1]
 000019        // [fsm_state t.ifchain_twice_u.state::S2]
              else if (state == S2) state <= S1;
            end
        endmodule
        
        // The next state's default is overwritten before the case on it
        module fsm_nextstate_overwrite (
            input logic clk,
            input logic rst,
            input logic start
        );
          import fsm_styles_pkg::*;
          st_t state_q, state_d;
          always_comb begin
            state_d = state_q;
            if (start) state_d = S1;
 000020     case (state_d)
        // [FSM coverage]
 000019        // [fsm_arc t.nextstate_overwrite_u.state_q::S0->S2]
 000019        // [fsm_arc t.nextstate_overwrite_u.state_q::S2->S0]
 000020        // [fsm_state t.nextstate_overwrite_u.state_q::S0]
 000019        // [fsm_state t.nextstate_overwrite_u.state_q::S2]
              S0: state_d = S2;
              S1: state_d = S2;
              S2: state_d = S0;
              default: state_d = S0;
            endcase
          end
          always_ff @(posedge clk) if (rst) state_q <= S0; else state_q <= state_d;
        endmodule
        
        // Values outside the enum are not states: the reset gives no reset arc, the assignment
        // no arc, and the case item nothing
        module fsm_enum_unknown_value (
            input logic clk,
            input logic rst,
            input logic go
        );
          typedef enum logic [1:0] {
            E0 = 2'd0,
            E1 = 2'd1,
            E2 = 2'd2
          } e_t;
          e_t state;
          /* verilator lint_off COVERIGN */
          always_ff @(posedge clk)
            if (rst) state <= e_t'(3);
            else
 000011       case (state)
        // [FSM coverage]
 000010        // [fsm_arc t.enum_unknown_value_u.state::E0->E1]
 000011        // [fsm_state t.enum_unknown_value_u.state::E0]
 000010        // [fsm_state t.enum_unknown_value_u.state::E1]
                E0: if (go) state <= E1;
                E1: state <= e_t'(3);
                e_t'(3): state <= E0;
                default: state <= E0;
              endcase
          /* verilator lint_on COVERIGN */
        endmodule
        
        // A non-enum register given a non-constant value: not an FSM
        module fsm_nonenum_var_target (
            input logic clk,
            input logic rst,
            input logic [1:0] paddr_lo
        );
          logic [1:0] state;
          always_ff @(posedge clk)
            if (rst) state <= 2'd0;
            else
              case (state)
                2'd0: state <= 2'd1;
                2'd1: state <= paddr_lo;
                default: state <= 2'd0;
              endcase
        endmodule
        
