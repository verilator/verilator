 000010        // [fsm_arc t.width_copies_u.st6::4'h2->4'h0]
 000020        // [fsm_state t.width_copies_u.st6::4'h0]
 000010        // [fsm_state t.width_copies_u.st6::4'h1]
 000010        // [fsm_state t.width_copies_u.st6::4'h2]
            else st6 <= 4'd0;
          /* verilator lint_on WIDTH */
        endmodule
        
        // A next state wider than the register, truncated into it: the states are its low bits, IDLE,
        // RUN and 2'h2, and the first split is a reset; st_w holds through its wider next state; st_lo,
        // given its own low bit, is not reported
        module fsm_wide_next (
            input logic clk,
            input logic rst,
            input logic go
        );
          localparam logic [1:0] IDLE = 2'b00, RUN = 2'b01, DONE = 2'b10;
          logic [1:0] state, st_w, st_lo;
          logic [2:0] next_state, st_w_next;
          /* verilator lint_off WIDTH */
          always @(posedge clk) state <= rst ? {1'b0, IDLE} : next_state;
          always @(posedge clk) st_w <= rst ? {1'b0, IDLE} : st_w_next;
          always_comb begin
            st_w_next = st_w;
 000020     if (st_w == IDLE && go) st_w_next = {1'b1, RUN};
        // [FSM coverage]
 000019        // [fsm_arc t.wide_next_u.st_w::IDLE->RUN]
 000019        // [fsm_arc t.wide_next_u.st_w::RUN->IDLE]
 000020        // [fsm_state t.wide_next_u.st_w::IDLE]
 000019        // [fsm_state t.wide_next_u.st_w::RUN]
            else if (st_w == RUN) st_w_next = {1'b0, IDLE};
          end
          always @(posedge clk)
            if (rst) st_lo <= 2'd0;
            else
              case (st_lo)
                2'd0: st_lo <= 2'd1;
                2'd1: st_lo <= 2'd2;
                default: st_lo <= st_lo[0];
              endcase
          /* verilator lint_on WIDTH */
          always @(state or go)
~000010     case (state)
        // [FSM coverage]
%000009        // [fsm_arc t.wide_next_u.state::2'h2->IDLE]
 000010        // [fsm_arc t.wide_next_u.state::IDLE->RUN]
 000010        // [fsm_arc t.wide_next_u.state::RUN->2'h2]
%000000        // [fsm_arc t.wide_next_u.state::RUN->IDLE]
 000010        // [fsm_state t.wide_next_u.state::2'h2]
 000010        // [fsm_state t.wide_next_u.state::IDLE]
 000010        // [fsm_state t.wide_next_u.state::RUN]
              IDLE: next_state = go ? {1'b1, RUN} : {1'b0, IDLE};
              RUN: next_state = {1'b1, DONE};
              default: next_state = {1'b0, IDLE};
            endcase
        endmodule
        
        // Writes that are not followed, so neither register is reported: an enum state written inside
        // a for loop, and a two-bit state written through part selects beside a full write
        module fsm_unfollowed_writes (
            input logic clk,
            input logic rst,
            input logic go
        );
          import fsm_styles_pkg::*;
          st_t sl;
          logic [1:0] sp;
          always_ff @(posedge clk)
            if (rst) sl <= S0;
            else
              for (int i = 0; i < 1; ++i)
                case (sl)
                  S0: if (go) sl <= S1;
                  S1: sl <= S2;
                  default: sl <= S0;
                endcase
          always_ff @(posedge clk)
            if (rst) sp <= 2'd0;
            else
              case (sp)
                2'd0: sp[0] <= 1'b1;
                2'd1: sp[1:0] <= 2'd2;
                default: sp <= 2'd0;
              endcase
        endmodule
        
        // Not FSMs: a counter, and a pipeline register of a state-typed value
        module fsm_not_fsms (
            input logic clk,
            input logic rst,
            input fsm_styles_pkg::st_t din
        );
          import fsm_styles_pkg::*;
          logic [3:0] cnt;
          st_t q;
          always_ff @(posedge clk) begin
            cnt <= rst ? 4'd0 : cnt + 4'd1;
            q <= din;
          end
        endmodule
        
        // The next-state logic in an instance of its own
        module fsm_child_logic (
            input logic [1:0] state,
            input logic go,
            output logic [1:0] nxt
        );
          always_comb begin
            nxt = state;
~000010     case (state)
        // [FSM coverage]
 000010        // [fsm_arc t.child_next_u.state2::2'h0->2'h1]
%000000        // [fsm_arc t.child_next_u.state2::2'h1->2'h0]
 000010        // [fsm_arc t.child_next_u.state2::2'h1->2'h2]
%000009        // [fsm_arc t.child_next_u.state2::2'h2->2'h0]
 000010        // [fsm_arc t.child_next_u.state::2'h0->2'h1]
%000000        // [fsm_arc t.child_next_u.state::2'h1->2'h0]
 000010        // [fsm_arc t.child_next_u.state::2'h1->2'h2]
%000009        // [fsm_arc t.child_next_u.state::2'h2->2'h0]
 000010        // [fsm_state t.child_next_u.state2::2'h0]
 000010        // [fsm_state t.child_next_u.state2::2'h1]
 000010        // [fsm_state t.child_next_u.state2::2'h2]
 000010        // [fsm_state t.child_next_u.state::2'h0]
 000010        // [fsm_state t.child_next_u.state::2'h1]
 000010        // [fsm_state t.child_next_u.state::2'h2]
              2'd0: if (go) nxt = 2'd1;
              2'd1: nxt = 2'd2;
              default: nxt = 2'd0;
            endcase
          end
        endmodule
        
        // Two instances, so their ports are copies rather than the parent's variables
        module fsm_child_next (
            input logic clk,
            input logic rst,
            input logic go
        );
          logic [1:0] state, nxt, state2, nxt2;
          fsm_child_logic logic_u (.*);
          fsm_child_logic logic2_u (
              .state(state2),
              .go(go),
              .nxt(nxt2)
          );
          always_ff @(posedge clk) state <= rst ? 2'd0 : nxt;
          always_ff @(posedge clk) state2 <= rst ? 2'd0 : nxt2;
        endmodule
        
        // The last split of a chain has a constant on both sides: neither is the reset
        module fsm_both_constant (
            input logic clk,
            input logic rst_n,
            input logic go
        );
          import fsm_styles_pkg::*;
          st_t state;
          always_ff @(posedge clk)
~000011     if (state == S1 && go) state <= S2;
        // [FSM coverage]
 000010        // [fsm_arc t.both_constant_u.state::S0->S1]
%000000        // [fsm_arc t.both_constant_u.state::S1->S0]
 000010        // [fsm_arc t.both_constant_u.state::S1->S2]
 000010        // [fsm_arc t.both_constant_u.state::S2->S0]
 000011        // [fsm_state t.both_constant_u.state::S0]
 000010        // [fsm_state t.both_constant_u.state::S1]
 000010        // [fsm_state t.both_constant_u.state::S2]
            else if (state == S2) state <= S0;
            else if (rst_n) state <= S1;
            else state <= S0;
        endmodule
        
        // A later statement overriding the reset: the reset is still the first if
        module fsm_reset_override (
            input logic clk,
            input logic rst,
            input logic go,
            input logic abort
        );
          import fsm_styles_pkg::*;
          st_t state;
          always_ff @(posedge clk) begin
            if (rst) state <= S0;
            else
~000011       case (state)
        // [FSM coverage]
%000009        // [fsm_arc t.reset_override_u.state::S0->S1]
%000001        // [fsm_arc t.reset_override_u.state::S0->S3]
%000000        // [fsm_arc t.reset_override_u.state::S1->S0]
%000009        // [fsm_arc t.reset_override_u.state::S1->S2]
%000000        // [fsm_arc t.reset_override_u.state::S1->S3]
%000009        // [fsm_arc t.reset_override_u.state::S2->S0]
%000000        // [fsm_arc t.reset_override_u.state::S2->S3]
%000001        // [fsm_arc t.reset_override_u.state::S3->S0]
 000011        // [fsm_state t.reset_override_u.state::S0]
%000009        // [fsm_state t.reset_override_u.state::S1]
%000009        // [fsm_state t.reset_override_u.state::S2]
%000001        // [fsm_state t.reset_override_u.state::S3]
                S0: if (go) state <= S1;
                S1: state <= S2;
                default: state <= S0;
              endcase
            if (abort) state <= S3;
          end
        endmodule
        
        class fsm_token;
        endclass
        
        // A condition comparing class handles, which aren't bit patterns
        module fsm_class_compare (
            input logic clk,
            input logic rst,
            input logic go,
            input logic done
        );
          import fsm_styles_pkg::*;
          st_t state;
          fsm_token a, b;
          initial a = new;
          always_ff @(posedge clk) b <= done ? a : null;
          always_ff @(posedge clk)
            if (rst) state <= S0;
            else
~000020       case (state)
        // [FSM coverage]
 000010        // [fsm_arc t.class_compare_u.state::S0->S1]
 000010        // [fsm_arc t.class_compare_u.state::S0->S2]
%000009        // [fsm_arc t.class_compare_u.state::S1->S0]
 000010        // [fsm_arc t.class_compare_u.state::S2->S0]
 000020        // [fsm_state t.class_compare_u.state::S0]
 000010        // [fsm_state t.class_compare_u.state::S1]
 000010        // [fsm_state t.class_compare_u.state::S2]
                S0: state <= (a == b) ? S1 : S2;
                default: if (go) state <= S0;
              endcase
        endmodule
        
        module t (
            input logic clk
        );
          import fsm_styles_pkg::*;
          integer cyc;
          logic rst, rst_n, flush, go, en, start, done, a, b, abort, wr, trst, tms;
          logic [15:0] paddr;
          logic [7:0] wdata;
          st_t din;
        
          fsm_two_proc two_proc_u (.*);
          fsm_other_assign other_assign_u (.*);
          fsm_enable enable_u (.*);
          fsm_compound_reset compound_reset_u (.*);
          fsm_input_guard input_guard_u (.*);
          fsm_or_states or_states_u (.*);
          fsm_three_targets three_targets_u (.*);
          fsm_beside_others beside_others_u (.*);
          fsm_ternary_hold ternary_hold_u (.*);
          fsm_default_override default_override_u (.*);
          fsm_reset_other_first reset_other_first_u (.*);
          fsm_case_on_wire case_on_wire_u (.*);
          fsm_unsized_params unsized_params_u (.*);
          fsm_alias_cond alias_cond_u (.*);
          fsm_two_in_block two_in_block_u (.*);
          fsm_two_in_comb two_in_comb_u (.*);
          fsm_same_reg_twice same_reg_twice_u (.*);
          fsm_ifchain_twice ifchain_twice_u (.*);
          fsm_nextstate_overwrite nextstate_overwrite_u (.*);
          fsm_enum_unknown_value enum_unknown_value_u (.*);
          fsm_plain_always plain_always_u (.*);
          fsm_nonenum_x_target nonenum_x_target_u (.*);
          fsm_nonenum_var_target nonenum_var_target_u (.paddr_lo(paddr[1:0]), .*);
          fsm_clocked_temporary clocked_temporary_u (.*);
          fsm_case_without_assign case_without_assign_u (.*);
          fsm_case_inside case_inside_u (.*);
          fsm_casez_concat casez_concat_u (.*);
          fsm_concat_compare concat_compare_u (.*);
          fsm_nested_temporary nested_temporary_u (.*);
          fsm_deep_temporaries deep_temporaries_u (.*);
          fsm_deep_alias_chain deep_alias_chain_u (.*);
          fsm_expression_clock expression_clock_u (.*);
          fsm_real_register real_register_u (.*);
          fsm_narrow_select narrow_select_u (.*);
          fsm_task_write task_write_u (.*);
          fsm_comb_temporary comb_temporary_u (.*);
          fsm_load_beside_case load_beside_case_u (.din(wdata[1:0]), .*);
          fsm_overlapping_guards overlapping_guards_u (.*);
          fsm_impossible_compare impossible_compare_u (.*);
          fsm_output_decoder output_decoder_u (.*);
          fsm_param_alias param_alias_u (.*);
          fsm_many_paths many_paths_u (.*);
          fsm_opaque_temporary opaque_temporary_u (.*);
          fsm_two_writers two_writers_u (.*);
          fsm_shared_temporary shared_temporary_u (.*);
          fsm_load_constant load_constant_u (.*);
          fsm_case_equality case_equality_u (.*);
          fsm_real_temporary real_temporary_u (.*);
          fsm_guarded_next guarded_next_u (.*);
          fsm_computed_reset computed_reset_u (.*);
          fsm_width_copies width_copies_u (.*);
          fsm_wide_next wide_next_u (.*);
          fsm_unfollowed_writes unfollowed_writes_u (.*);
          fsm_not_fsms not_fsms_u (.*);
          fsm_child_next child_next_u (.*);
          fsm_both_constant both_constant_u (.*);
          fsm_reset_override reset_override_u (.*);
          fsm_class_compare class_compare_u (.*);
        
          initial cyc = 0;
        
          always_comb begin
            rst = cyc < 2;
            rst_n = !rst;
            trst = !rst;
            flush = cyc == 9;
            go = cyc[0];
            en = cyc[1] | cyc[0];
            start = cyc == 5;
            done = cyc[2];
            a = cyc[1];
            b = cyc[2];
            abort = cyc == 7;
            wr = cyc[0];
            tms = cyc[1];
            paddr = cyc[0] ? 16'h4000 : 16'h0000;
            wdata = cyc[7:0];
            din = st_t'(cyc[1:0]);
          end
        
          always @(posedge clk) begin
            cyc <= cyc + 1;
            if (cyc == 40) begin
              $write("*-* All Finished *-*\n");
              $finish;
            end
          end
        endmodule
        
