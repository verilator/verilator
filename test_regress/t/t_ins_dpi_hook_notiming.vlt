`verilator_config

// A register, an interface signal, a nested one, and one in a generate block
insert_dpihook -callback "cb" -var "top_module.mreg"
insert_dpihook -callback "cb" -var "top_module.di.data"
insert_dpihook -callback "cb" -var "top_module.oi.inner.data"
insert_dpihook -callback "cb" -var "top_module.lane[1].gi.data"
