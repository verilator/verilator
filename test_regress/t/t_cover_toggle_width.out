              memory[cyc + 'd100] <= memory[cyc + 'd100] + 2'b1;
              toggle <= '0;
              stoggle.u <= toggle;
              stoggle.b <= toggle;
              utoggle.val1 <= real'(cyc[7:0]);
              ptoggle[0][0] <= toggle;
