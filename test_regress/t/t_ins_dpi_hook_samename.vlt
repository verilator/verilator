`verilator_config

insert_dpihook -callback "cb_samename" -var "top_module.u.u.sig"
insert_dpihook -callback "cb_samename" -var "top_module.v.u.sig"
insert_dpihook -callback "instrument_var" -var "top_module.s.r"
insert_dpihook -callback "instrument_var" -var "top_module.s.wb"
