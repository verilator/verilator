`verilator_config

// An element and a variable named like it, a generate-scope variable and one named like it
insert_dpihook -callback "cb" -var "top_module.mem[2]"
insert_dpihook -callback "cb" -var "top_module.mem_2"
insert_dpihook -callback "cb" -var "top_module.g[0].x"
insert_dpihook -callback "cb" -var "top_module.x_g_0"
