//      // verilator_coverage annotation
        // DESCRIPTION: Verilator: FSM coverage with a compound reset and line and expression coverage
        //
        // This file ONLY is placed under the Creative Commons Public Domain
        // SPDX-FileCopyrightText: 2026 David Harris
        // SPDX-License-Identifier: CC0-1.0
        
        module t (
            input clk
        );
        
          typedef enum logic [1:0] {
            IDLE,
            RUN,
            DONE
          } state_t;
        
          state_t state;
          state_t state_next;
          logic rst;
          logic flush;
          logic go;
          logic last;
          state_t state2;
          state_t state2_next;
          state_t state3;
          state_t state3_v;
          int cyc;
        
          // Reset and flush share the reset branch, as in a pipeline stage that
          // returns to IDLE on either.
          always_ff @(posedge clk) begin
%000009     if (rst | flush) state <= IDLE;
%000009     else state <= state_next;
          end
        
          // The same reset as a conditional, which expression coverage instruments
          always_ff @(posedge clk) begin
%000009     state2 <= (rst | flush) ? IDLE : state2_next;
          end
        
          // Branch coverage turns the conditional into this form on a temporary, but a
          // user variable is not accepted, so state3 has no FSM coverage
          always_ff @(posedge clk) begin
%000009     if (rst | flush) state3_v = IDLE;
%000009     else state3_v = state2_next;
            state3 <= state3_v;
          end
        
          always_comb begin
%000003     case (state2)
        // [FSM coverage]
%000002        // [fsm_arc t.state2::DONE->IDLE]
%000002        // [fsm_arc t.state2::IDLE->RUN]
%000002        // [fsm_arc t.state2::RUN->DONE]
%000000        // [fsm_arc t.state2::RUN->IDLE]
%000002        // [fsm_state t.state2::DONE]
%000003        // [fsm_state t.state2::IDLE]
%000002        // [fsm_state t.state2::RUN]
              IDLE:
              if (go) state2_next = RUN;
              else state2_next = IDLE;
              RUN: state2_next = DONE;
              default: state2_next = IDLE;
            endcase
          end
        
          always_comb begin
%000003     case (state)
        // [FSM coverage]
%000001        // [fsm_arc t.state::DONE->IDLE]
%000002        // [fsm_arc t.state::IDLE->RUN]
%000001        // [fsm_arc t.state::RUN->DONE]
%000001        // [fsm_arc t.state::RUN->IDLE]
%000001        // [fsm_state t.state::DONE]
%000003        // [fsm_state t.state::IDLE]
%000002        // [fsm_state t.state::RUN]
              IDLE:
              if (go) state_next = RUN;
              else state_next = IDLE;
              RUN:
              if (last) state_next = DONE;
              else state_next = RUN;
              DONE: state_next = IDLE;
              default: state_next = IDLE;
            endcase
          end
        
          initial cyc = 0;
        
          always @(posedge clk) begin
            cyc <= cyc + 1;
            rst <= (cyc == 0);
            flush <= (cyc == 4);
            go <= (cyc == 1) || (cyc == 5);
            last <= (cyc == 7);
~000010     if (cyc == 10) begin
%000001       $write("*-* All Finished *-*\n");
%000001       $finish;
            end
          end
        endmodule
        
