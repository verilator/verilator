`verilator_config
// Worker 0 is the thread calling eval; the list for --threads 8 is not used
threads_group -module "tile" -workers 4->2: { 0 1 0 1 } -workers 4->8: { 0 2 4 6 }
threads_group -module "acc" -workers 4->2: { 1 0 1 0 }
threads_group -module "chk" -workers 1->2: { 1 }
