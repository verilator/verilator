    LVL1 (vpiParameter) t.LVL1  vpiConstType=vpiDecConst
    bus_addr (vpiReg) t.bus_addr 
    bus_wdata (vpiReg) t.bus_wdata 
    bus_we (vpiReg) t.bus_we 
    clk (vpiReg) TOP.clk 
    cnt (vpiReg) t.cnt 
    ctrl_dup (vpiReg) t.ctrl_dup 
