    lvl1 (vpiRegArray) t.lvl1 
        vpiReg:
        lvl1 (vpiReg) t.lvl1[3] 
        lvl1 (vpiReg) t.lvl1[2] 
        lvl1 (vpiReg) t.lvl1[1] 
        lvl1 (vpiReg) t.lvl1[0] 
    lvl2 (vpiRegArray) t.lvl2 
        vpiReg:
        lvl2 (vpiReg) t.lvl2[1] 
        lvl2 (vpiReg) t.lvl2[0] 
    picked (vpiReg) t.picked 
    rst (vpiReg) t.rst 
    set_a (vpiReg) t.set_a 
    status (vpiReg) t.status 
    vpiParameter:
    A_CTRL (vpiParameter) t.A_CTRL  vpiConstType=vpiDecConst
    LVL0 (vpiParameter) t.LVL0  vpiConstType=vpiDecConst
