`verilator_config

insert_dpihook -callback "cb_array" -var "top_module.mem"
insert_dpihook -callback "instrument_var" -var "top_module.s.mem[2]"
insert_dpihook -callback "cb_elem" -var "top_module.m[5]"
insert_dpihook -callback "cb_elem" -var "top_module.d[6]"
